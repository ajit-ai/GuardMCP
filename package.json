{
  "name": "guardmcp",
  "version": "1.0.0",
  "description": "GuardMCP - Security-first MCP server for vulnerability scanning via NVD, OSV, npm and GitHub Advisory",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "guardmcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "keywords": ["mcp", "security", "cve", "nvd", "osv", "vulnerability", "ai", "claude"],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
