# NVD API - get free key from https://nvd.nist.gov/developers/request-an-api-key
# Without key: 5 requests / 30s. With key: 50 requests / 30s
NVD_API_KEY=

# GitHub token for Advisory API (optional, increases rate limit)
GITHUB_TOKEN=

# Cache TTLs (ms) - defaults: CVE 1h, Package 24h
# CVE_CACHE_TTL=3600000
# PACKAGE_CACHE_TTL=86400000

# Audit log path (default: ./logs/audit.log)
# AUDIT_LOG_PATH=./logs/audit.log
# AUDIT_LOG_ENABLED=true

# Server
# LOG_LEVEL=info
