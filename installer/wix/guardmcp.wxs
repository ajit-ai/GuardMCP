<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <!-- GuardMCP Windows Installer — WiX v3/v4 compatible -->
  <Product Id="*" Name="GuardMCP" Language="1033" Version="1.0.0" Manufacturer="ajit-ai" UpgradeCode="a1b2c3d4-e5f6-47a8-b9c0-d1e2f3a4b5c6">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Description="GuardMCP - Security-first MCP server for AI agents" Comments="https://github.com/ajit-ai/GuardMCP" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of GuardMCP is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Feature Id="ProductFeature" Title="GuardMCP" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="PathEnv" />
    </Feature>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="GuardMCP">
          <Component Id="GuardMCPExe" Guid="b2c3d4e5-f6a7-48b9-c0d1-e2f3a4b5c6d7">
            <File Id="GuardMCPExeFile" Source="..\..\dist\bin\guardmcp-win-x64.exe" Name="guardmcp.exe" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="GuardMCP" />
      </Directory>
    </Directory>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="CmpConfig" Guid="c3d4e5f6-a7b8-49c0-d1e2-f3a4b5c6d7e8" Directory="INSTALLFOLDER">
        <File Id="ReadmeFile" Source="..\..\README.md" Name="README.md" />
      </Component>
    </ComponentGroup>
    <!-- Add to PATH -->
    <Component Id="PathEnv" Guid="d4e5f6a7-b8c9-40d1-e2f3-a4b5c6d7e8f9" Directory="INSTALLFOLDER">
      <Environment Id="PATH" Name="PATH" Value="[INSTALLFOLDER]" Permanent="no" Part="last" Action="set" System="yes" />
    </Component>
    <WixVariable Id="WixUILicenseRtf" Value="..\..\LICENSE" />
  </Product>
</Wix>
